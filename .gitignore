/build/
# Unified deploy destination (final exes + deployed DLLs, never tracked)
/dist/
# Qt/qmake build artifacts
build-*/
Client/_github_bundle_repo/

# Qt Creator user settings
*.pro.user
*.pro.user.*

# qmake generated files
Makefile
Makefile.Debug
Makefile.Release
Makefile.*
object_script.*.Debug
object_script.*.Release
.qmake.stash

# Qt build object files and moc
debug/
release/
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.o
*.obj
*.moc

# Qt resource compiled files
*.qrc.depends

# IDE / Editor
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated
.DS_Store
Thumbs.db
Desktop.ini

# Binary executables
*.exe

# AI and local planning
/.claude/
/.planning/
/.ui_headers_backup_*/

# 历史治理与管线保留在本机；四文件规则见根目录 AGENTS.md。
# 保持既有协作入口的本地策略，不自动把本地历史或凭据纳入 Git。
/AGENTS.md
/CLAUDE.md
/pipeline/
/docs/archive/

# 保留原测试与基础 SQL 的路径兼容。旧 manifest 已随治理历史归档。
# 忽略目录子项而非目录本身，保证下面的测试及 SQL 例外有效。
/project-docs/*
!/project-docs/init_test_data.sql
!/project-docs/evidence/
/project-docs/evidence/*
!/project-docs/evidence/*/
/project-docs/evidence/**/*.log
/project-docs/evidence/**/*.txt
/project-docs/evidence/**/*.md
/project-docs/evidence/**/*.json
/project-docs/evidence/**/*.png
/project-docs/evidence/**/*.diff
/project-docs/evidence/**/*.patch
/project-docs/evidence/**/*.cpp
# 例外：REQ-EXT-GROUP-004 的游标探针是**测试代码**，与上面 *.py 套件同等地位。
# 它直接编译产品头文件 Client/groupchatstate.h（客户端游标逻辑 socket 套件驱动不到），
# 被 verify.py 调用；不入库则套件在别处无法复现。仍然只放行这一个文件名，不放行 *.cpp。
!/project-docs/evidence/**/cursor_probe.cpp
# REQ-CLI-MSGSTORE-001 同理：存储层断言探针直接编译产品源码 Client/messagestore.cpp，
# 被同目录 verify.py 调用，不入库则套件在别的检出上无法复现。仍只放行这一个文件名。
!/project-docs/evidence/**/store_probe.cpp
# REQ-CLI-MSGBND-001 同理：正文边界探针直接编译产品源码 Server/protocol.cpp（畸形报文与
# 码点裁剪无法由 socket 套件断言到函数级），被同目录 verify.py 调用，不入库则套件在别的
# 检出上无法复现。仍只放行这一个文件名。
!/project-docs/evidence/**/boundary_probe.cpp
# REQ-EXT-TLS-001 同理：TLS 三/TLS 五 探针直接编译产品 Source Client/tlspinning.cpp（pinning 规则的唯一落点），被同目录 verify.py 调用；不入库则在别的检出上无法复现。仍只放行这一个文件名，不放行 *.cpp
!/project-docs/evidence/**/pinning_probe.cpp
/project-docs/evidence/**/*.out
/project-docs/evidence/**/*.sql
/project-docs/evidence/**/*.sh
/project-docs/evidence/**/*.ps1
/project-docs/evidence/manifest
/project-docs/evidence/REPORT*

# Local documentation and resume tooling
/findings.md
/progress.md
/task_plan.md
/update_resume.ps1
/update_resume_docx.py
/项目面试文档.md
/output/

# Local tests and AI task prompts
/regression_publink_test.py
/smoke_test.py
/tier2_publink_simulation.py
/task_prompt_*.txt

# Redundant vendored material and generated runtime data
/Server/qtbase/
/Server/project-docs/
/Server/filesys/

# Local credentials -- never track. Use connect.config.template as the reference.
/Server/connect.config
/Server/connect.config.bak-*
/Client/connect.config
/Client/connect.config.bak-*
/Client/connect.config.local

# Python cache
__pycache__/
*.pyc

# Codegraph index (local tooling artifact)
.codegraph/

# Local run artifacts produced by the gate / audit scripts and ad-hoc runs. The
# build/, dist/ and evidence/ rules above already stop most of these; this catches
# strays at any path (a gate run started from the repo root drops its log here).
*.log
*.tmp
*.bak
*.orig
*.rej

# Local runtime databases. The server's file store (Server/filesys/) is already
# ignored above; these cover any sqlite/db file dropped by a local experiment.
*.db
*.sqlite
*.sqlite3

# Evidence products the enumerated extension list above does not name yet. Both shapes were found
# tracked in this repo (FINDING-GATE-2-lifecycle/.../events.ndjson and
# TRANSFER-003/.../concurrent-audit-repair.diff.regenerated) -- `*.diff` does not match the latter.
/project-docs/evidence/**/*.ndjson
/project-docs/evidence/**/*.regenerated

# Qt Creator / CMake strays not covered by the rules above.
*.autosave
.qtc_clangd/
CMakeLists.txt.user

# REQ-WEB-001 网页端：依赖与构建产物不入库，源码与 package-lock 保留。
web/**/node_modules/
web/frontend/dist/
web/**/.vite/
web/**/*.local

# REQ-EXT-TLS-001: TLS private keys / certs never tracked (dist/ already ignored; this guards stray copies)
*.key
*.crt

# REQ-EXT-TLS-001: relay 取证的临时证书与链路 dump 不入库
project-docs/evidence/REQ-EXT-TLS-001/relay_certs/
project-docs/evidence/REQ-EXT-TLS-001/relay_dumps/

# 2026-11-14 dir cleanup append
.qoder/
docs/_q*.txt
