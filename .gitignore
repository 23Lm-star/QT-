# Redundant vendored material and generated runtime data
/Server/qtbase/
/Server/project-docs/
/Server/filesys/

# Local credentials -- never track. Use connect.config.template as the reference.
/Server/connect.config
/Server/connect.config.bak-*
/Client/connect.config
/Client/connect.config.bak-*
/Client/connect.config.local

# Python cache
__pycache__/
*.pyc

# Codegraph index (local tooling artifact)
.codegraph/

# Local run artifacts produced by the gate / audit scripts and ad-hoc runs. The
# build/, dist/ and evidence/ rules above already stop most of these; this catches
# strays at any path (a gate run started from the repo root drops its log here).
*.log
*.tmp
*.bak
*.orig
*.rej

# Local runtime databases. The server's file store (Server/filesys/) is already
# ignored above; these cover any sqlite/db file dropped by a local experiment.
*.db
*.sqlite
*.sqlite3

# Evidence products the enumerated extension list above does not name yet. Both shapes were found
# tracked in this repo (FINDING-GATE-2-lifecycle/.../events.ndjson and
# TRANSFER-003/.../concurrent-audit-repair.diff.regenerated) -- `*.diff` does not match the latter.
/project-docs/evidence/**/*.ndjson
/project-docs/evidence/**/*.regenerated

# Qt Creator / CMake strays not covered by the rules above.
*.autosave
.qtc_clangd/
CMakeLists.txt.user
